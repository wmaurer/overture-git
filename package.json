{
    "name": "@wmaurer/overture-git",
    "version": "1.0.0",
    "description": "AI-powered git workflow tools — generate conventional commit messages and create worktrees with smart branch names using Claude",
    "keywords": [
        "git",
        "commit",
        "ai",
        "claude",
        "conventional-commits",
        "worktree",
        "cli",
        "effect"
    ],
    "license": "ISC",
    "author": "Wayne Maurer",
    "repository": {
        "type": "git",
        "url": "https://github.com/wmaurer/overture-git.git"
    },
    "homepage": "https://github.com/wmaurer/overture-git",
    "bugs": {
        "url": "https://github.com/wmaurer/overture-git/issues"
    },
    "bin": {
        "ogit": "dist/main.js"
    },
    "type": "module",
    "main": "dist/main.js",
    "files": [
        "dist/"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "prepare": "effect-language-service patch",
        "prepublishOnly": "pnpm build && pnpm test",
        "build": "tsc",
        "dev": "tsc --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "lint": "oxlint",
        "fmt": "oxfmt .",
        "fmt:check": "oxfmt --check ."
    },
    "dependencies": {
        "@bgotink/kdl": "^0.4.0",
        "@effect/ai-anthropic": "4.0.0-beta.47",
        "@effect/platform-node": "4.0.0-beta.47",
        "effect": "4.0.0-beta.47",
        "env-paths": "^4.0.0"
    },
    "devDependencies": {
        "@effect/language-service": "^0.85.1",
        "@effect/vitest": "4.0.0-beta.47",
        "oxfmt": "^0.44.0",
        "oxlint": "^1.59.0",
        "typescript": "^6.0.2",
        "vitest": "^4.1.4"
    },
    "packageManager": "pnpm@10.32.1"
}
