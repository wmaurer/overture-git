{
    "printWidth": 120,
    "tabWidth": 4,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "arrowParens": "always",
    "endOfLine": "lf",
    "sortImports": {
        "newlinesBetween": true,
        "groups": [
            "value-builtin",
            "value-external",
            "value-internal",
            ["value-parent", "value-sibling", "value-index"],
            "type-import",
            "unknown"
        ]
    },
    "ignorePatterns": ["**/dist", "pnpm-lock.yaml"]
}
